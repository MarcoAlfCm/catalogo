# Catálogo · variables mínimas para producción
NODE_ENV=production
PORT=3015

# Base de datos
DATA_SOURCE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=catalogo_user
DB_PASSWORD=cambia_esta_contrasena
DB_NAME=catalogo_czc

# Sesiones
ADMIN_SESSION_SECRET=cambia_esto_por_un_secreto_largo_de_32_caracteres
CUSTOMER_SESSION_SECRET=cambia_esto_por_otro_secreto_largo_de_32_caracteres
CUSTOMER_SESSION_HOURS=168

# DeepSeek para pedidos personalizados
DEEPSEEK_API_KEY=pon_aqui_tu_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_JSON_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=45000

# Uploads
UPLOAD_MAX_BYTES=5242880
CUSTOM_ORDER_UPLOAD_MAX_BYTES=5242880
